  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Financial Runtime Path",
      "items": [
        "Vue 3 SPA attaches Firebase Bearer JWT to Axios API requests against NestJS REST endpoints",
        "NestJS global guards (Throttler & FirebaseAuthGuard) authenticate identity before controller dispatch",
        "Application use cases orchestrate domain entities and invoke RecordOperationUseCase",
        "Accounting Engine strictly validates the double-entry bookkeeping zero-sum balance (debits = credits)",
        "TypeORM TransactionManager executes an atomic Unit of Work to commit Operation and Ledger records"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Ingress Security",
      "items": [
        "Public Client Zone: Untrusted browser environment running Vue 3 SPA + Pinia state",
        "External Identity: Firebase Auth manages credentials, MFA, and JWT signing outside backend servers",
        "Strict Hexagonal Isolation: Pure Domain layer has zero dependencies on application or infrastructure",
        "Managed Cloud Persistence: Isolated PostgreSQL instance hosted on Supabase accessed over SSL"
      ]
    },
    {
      "dot": "cyan",
      "title": "Architectural Invariants",
      "items": [
        "Hexagonal Dependency Rule: Dependencies point strictly inward (Infrastructure → Application → Domain)",
        "Double-Entry Accounting: All financial operations register balanced zero-sum ledger entries",
        "Financial Immutability: Historical entries are never edited or deleted; adjustments require compensating entries",
        "Centralized Dependency Injection: All NestJS Symbol() tokens are centralized in injection-tokens.ts"
      ]
    }
  ]
