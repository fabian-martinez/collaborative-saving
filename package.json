{
  "name": "collaborative-saving",
  "version": "1.0.0",
  "description": "Collaborative Saving Application",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:app",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:app": "cd frontend-v2 && npm run dev",
    "dev:mobile": "cd frontend-mobile && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend-v2 && npm install && cd ../frontend-mobile && npm install",
    "build": "npm-run-all build:backend build:app build:mobile",
    "build:backend": "cd backend && npm run build",
    "build:app": "cd frontend-v2 && npm run build",
    "build:mobile": "cd frontend-mobile && npm run build",
    "start": "npm-run-all --parallel start:backend start:app",
    "start:backend": "cd backend && npm run start:prod",
    "start:app": "cd frontend-v2 && npm run preview",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.48.0",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@neon/config": "^1.4.3",
    "@neon/env": "^1.3.3"
  }
}
