{
  "name": "collaborative-saving",
  "version": "1.0.0",
  "description": "Collaborative Saving Application",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:app dev:mobile",
    "dev:all": "npm-run-all --parallel dev:backend dev:app dev:mobile",
    "dev:web": "npm-run-all --parallel dev:backend dev:app",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:app": "cd frontend-v2 && npm run dev",
    "dev:mobile": "cd frontend-mobile && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend-v2 && npm install && cd ../frontend-mobile && npm install",
    "build": "npm-run-all build:backend build:app build:mobile",
    "build:backend": "cd backend && npm run build",
    "build:app": "cd frontend-v2 && npm run build",
    "build:mobile": "cd frontend-mobile && npm run build",
    "start": "npm-run-all --parallel start:backend start:app start:mobile",
    "start:backend": "cd backend && npm run start:prod",
    "start:app": "cd frontend-v2 && npm run preview",
    "deploy:hosting": "npx firebase-tools deploy --only hosting",
    "deploy:app": "npm run build:app && npx firebase-tools deploy --only hosting:web",
    "deploy:mobile": "npm run build:mobile && npx firebase-tools deploy --only hosting:mobile-collaborative-saving",
    "deploy:all": "npm run build:app && npm run build:mobile && npx firebase-tools deploy --only hosting",
    "db:migrate": "bash infra/database/scripts/migrate.sh up",
    "db:status": "bash infra/database/scripts/migrate.sh status",
    "db:baseline": "bash infra/database/scripts/migrate.sh baseline",
    "test:migrations": "bash infra/database/scripts/test-migrations.sh",
    "start:mobile": "cd frontend-mobile && npm run preview",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "markdownlint": "^0.41.1",
    "markdownlint-cli": "^0.49.1",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@neon/config": "^1.4.3",
    "@neon/env": "^1.3.3"
  },
  "overrides": {
    "shell-quote": "^1.9.0",
    "linkify-it": "^5.0.2",
    "brace-expansion@<=1.1.17": "^1.1.21",
    "brace-expansion@>=3.0.0 <=5.0.8": "^5.0.12",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.8.0"
  }
}
