# Entorno de ejecución (development, test, production)
# NODE_ENV=production

# Documentación de API (Swagger)
# En producción se encuentra deshabilitado por defecto para proteger esquemas y endpoints.
# Asigna ENABLE_SWAGGER=true si requieres habilitarlo explícitamente (ej. entornos de staging o prueba).
# ENABLE_SWAGGER=false

# Configuración del servidor backend
PORT=3000

# Lista de orígenes permitidos separados por comas.
# En producción se rechazan automáticamente comodines (*) por seguridad y compatibilidad con credenciales.
ALLOWED_ORIGINS=https://collaborative-saving.pages.dev,https://collaborative-saving.vercel.app,http://localhost:5173

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/base_de_datos
# Establecer en true para activar SSL (ej. para Neon Serverless Postgres o Render DB)
DATABASE_SSL=false

# Autenticación Firebase (Opción A: Archivo físico local)
GOOGLE_APPLICATION_CREDENTIALS=ruta/a/tu/archivo-service-account.json

# Autenticación Firebase (Opción B: Cadena JSON de entorno en producción)
# Pega todo el contenido del JSON de credenciales en esta variable sin saltos de línea
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Cifrado de Información Personal (PII) en Reposo (AES-256-GCM y Blind Index)
# Clave simétrica de 256 bits (32 bytes) en hexadecimal (64 chars) o base64 (44 chars)
# Generar ej: openssl rand -hex 32
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Sal secreta para el cálculo de Blind Indexes determinísticos (HMAC-SHA256)
# Generar ej: openssl rand -hex 32
APP_BLIND_INDEX_SALT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
