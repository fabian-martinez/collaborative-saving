{
  "info": {
    "name": "Ledger Entries API - Collaborative Saving",
    "description": "Colección de Postman para probar la API de asientos contables del sistema Collaborative Saving",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "URL base de la API"
    },
    {
      "key": "memberId",
      "value": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11",
      "type": "string",
      "description": "ID de ejemplo de un miembro"
    },
    {
      "key": "meetingId",
      "value": "b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a12",
      "type": "string",
      "description": "ID de ejemplo de una reunión"
    },
    {
      "key": "operationId",
      "value": "c0eebc99-9c0b-4ef8-bb6d-6bb9bd380a13",
      "type": "string",
      "description": "ID de ejemplo de una operación"
    },
    {
      "key": "ledgerEntryId",
      "value": "d0eebc99-9c0b-4ef8-bb6d-6bb9bd380a14",
      "type": "string",
      "description": "ID de ejemplo de un asiento contable"
    }
  ],
  "item": [
    {
      "name": "Account Types",
      "item": [
        {
          "name": "Get Account Types",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ledger-entries/account-types",
              "host": ["{{baseUrl}}"],
              "path": ["ledger-entries", "account-types"]
            },
            "description": "Obtiene la lista de todos los tipos de cuenta disponibles para filtrar asientos contables"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/ledger-entries/account-types",
                  "host": ["{{baseUrl}}"],
                  "path": ["ledger-entries", "account-types"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "[\n  {\n    \"value\": \"CASH\",\n    \"label\": \"Cash\"\n  },\n  {\n    \"value\": \"LOANS_RECEIVABLE\",\n    \"label\": \"Loans Receivable\"\n  },\n  {\n    \"value\": \"INVESTMENT_IN_STOCKS\",\n    \"label\": \"Investment in Stocks\"\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "name": "Ledger Entries",
      "item": [
        {
          "name": "Get All Ledger Entries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ledger-entries?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["ledger-entries"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Página (por defecto 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Resultados por página (por defecto 20, máximo 100)"
                }
              ]
            },
            "description": "Obtiene una lista paginada de asientos contables con información enriquecida"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/ledger-entries?page=1&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["ledger-entries"],
                  "query": [
                    {
                      "key": "page",
                      "value": "1"
                    },
                    {
                      "key": "limit",
                      "value": "20"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"data\": [\n    {\n      \"id\": \"d0eebc99-9c0b-4ef8-bb6d-6bb9bd380a14\",\n      \"operationId\": \"c0eebc99-9c0b-4ef8-bb6d-6bb9bd380a13\",\n      \"accountType\": \"CASH\",\n      \"amount\": 150000.00,\n      \"description\": \"Pago de cuota de préstamo\",\n      \"createdAt\": \"2025-01-15T10:30:00Z\",\n      \"operationType\": \"LOAN_PAYMENT\",\n      \"operationDescription\": \"Pago mensual de préstamo (capital + intereses)\",\n      \"operationDate\": \"2025-01-15T10:30:00Z\",\n      \"memberId\": \"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11\",\n      \"memberName\": \"Ana Gómez\",\n      \"meetingId\": \"b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a12\",\n      \"meetingDate\": \"2025-01-15T09:00:00Z\"\n    }\n  ],\n  \"page\": 1,\n  \"limit\": 20,\n  \"total\": 1\n}"
            }
          ]
        },
        {
          "name": "Get Ledger Entries with Filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ledger-entries?q=loan&memberId={{memberId}}&accountType=CASH&dateFrom=2025-01-01T00:00:00Z&dateTo=2025-12-31T23:59:59Z&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["ledger-entries"],
              "query": [
                {
                  "key": "q",
                  "value": "loan",
                  "description": "Búsqueda por texto en descripción o ID de operación"
                },
                {
                  "key": "memberId",
                  "value": "{{memberId}}",
                  "description": "Filtrar por ID de miembro"
                },
                {
                  "key": "accountType",
                  "value": "CASH",
                  "description": "Filtrar por tipo de cuenta"
                },
                {
                  "key": "dateFrom",
                  "value": "2025-01-01T00:00:00Z",
                  "description": "Fecha desde (ISO 8601)"
                },
                {
                  "key": "dateTo",
                  "value": "2025-12-31T23:59:59Z",
                  "description": "Fecha hasta (ISO 8601)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Página"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Resultados por página"
                }
              ]
            },
            "description": "Obtiene asientos contables filtrados por texto, miembro, tipo de cuenta y rango de fechas"
          }
        },
        {
          "name": "Get Ledger Entry by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ledger-entries/{{ledgerEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ledger-entries", "{{ledgerEntryId}}"]
            },
            "description": "Obtiene un asiento contable específico por su ID"
          }
        },
        {
          "name": "Get Ledger Entries by Operation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ledger-entries/operation/{{operationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ledger-entries", "operation", "{{operationId}}"]
            },
            "description": "Obtiene todos los asientos contables asociados a una operación específica"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/ledger-entries/operation/{{operationId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["ledger-entries", "operation", "{{operationId}}"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "[\n  {\n    \"id\": \"d0eebc99-9c0b-4ef8-bb6d-6bb9bd380a14\",\n    \"operationId\": \"{{operationId}}\",\n    \"accountType\": \"LOANS_RECEIVABLE\",\n    \"amount\": -150000.00,\n    \"description\": \"Reducción de saldo de préstamo\",\n    \"createdAt\": \"2025-01-15T10:30:00Z\",\n    \"operationType\": \"LOAN_PAYMENT\",\n    \"operationDescription\": \"Pago mensual de préstamo (capital + intereses)\",\n    \"operationDate\": \"2025-01-15T10:30:00Z\",\n    \"memberId\": \"{{memberId}}\",\n    \"memberName\": \"Ana Gómez\",\n    \"meetingId\": \"{{meetingId}}\",\n    \"meetingDate\": \"2025-01-15T09:00:00Z\",\n    \"loanId\": \"e0eebc99-9c0b-4ef8-bb6d-6bb9bd380a15\"\n  },\n  {\n    \"id\": \"f0eebc99-9c0b-4ef8-bb6d-6bb9bd380a16\",\n    \"operationId\": \"{{operationId}}\",\n    \"accountType\": \"CASH\",\n    \"amount\": 150000.00,\n    \"description\": \"Pago de cuota de préstamo\",\n    \"createdAt\": \"2025-01-15T10:30:01Z\",\n    \"operationType\": \"LOAN_PAYMENT\",\n    \"operationDescription\": \"Pago mensual de préstamo (capital + intereses)\",\n    \"operationDate\": \"2025-01-15T10:30:00Z\",\n    \"memberId\": \"{{memberId}}\",\n    \"memberName\": \"Ana Gómez\",\n    \"meetingId\": \"{{meetingId}}\",\n    \"meetingDate\": \"2025-01-15T09:00:00Z\"\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "name": "Operations (Reference)",
      "item": [
        {
          "name": "Get All Operations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/operations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["operations"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Página (por defecto 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Resultados por página (por defecto 20)"
                }
              ]
            },
            "description": "Obtiene una lista paginada de operaciones (endpoint de referencia ya implementado)"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script que se ejecuta antes de cada request",
          "console.log('Ejecutando request a: ' + pm.request.url);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script que se ejecuta después de cada response",
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test('Response has required headers', function () {",
          "    pm.response.to.have.header('Content-Type');",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ]
}
