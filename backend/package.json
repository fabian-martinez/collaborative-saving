{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run typeorm:migration:run && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:watch": "jest --coverage --watch",
    "test:unit": "jest --config jest.config.json",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:coverage:open": "open coverage/index.html",
    "test:fix": "jest --passWithNoTests --verbose",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:migration:generate": "npm run typeorm -- -d ./src/infrastructure/typeorm/data-source.ts migration:generate ./src/infrastructure/typeorm/migrations/create-config-tables",
    "typeorm:migration:run": "npm run typeorm -- -d ./src/infrastructure/typeorm/data-source.ts migration:run",
    "typeorm:migration:revert": "npm run typeorm -- -d ./src/infrastructure/typeorm/data-source.ts migration:revert",
    "db:migrate": "bash ../infra/database/scripts/migrate.sh up",
    "db:status": "bash ../infra/database/scripts/migrate.sh status",
    "db:baseline": "bash ../infra/database/scripts/migrate.sh baseline",
    "test:migrations": "bash ../infra/database/scripts/test-migrations.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@faker-js/faker": "^10.0.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.12.9",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.3.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "jest": "^30.0.4",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "testcontainers": "^11.5.1",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.7.3",
    "uuid": "11.1.1",
    "teeny-request": "^10.1.0",
    "brace-expansion@>=5.0.0 <5.0.6": "^5.0.6",
    "protobufjs@<=7.5.7": "^7.5.8",
    "qs@>=6.11.1 <=6.15.1": "^6.15.2"
  }
}